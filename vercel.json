{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/mcp.ts": {
      "runtime": "@vercel/node@5.8.22",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/mcp"
    }
  ],
  "ignoreCommand": "bash -c 'git diff --quiet HEAD^ HEAD -- . \":(exclude)*.md\"'"
}